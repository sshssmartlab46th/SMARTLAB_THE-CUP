rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Matches Collection
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Lineups Collection
    match /lineups/{lineupId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Messages (쪽지) Collection
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Cheers (실시간 응원) Collection
    match /cheers/{cheerId} {
      allow read, write: if isSignedIn();
    }

    // Injury Encyclopedia (부상 지식백과) Collection
    match /injuries/{injuryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Suggestions (실명 건의함) Collection
    match /suggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Audit Logs (스코어 수정 감사 로그 - 절대 불변/삭제 불가)
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Enforce strict immutability: no updates or deletes permitted
      allow update, delete: if false;
    }

    // System & Festival Config Collection
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // MVP Votes Collection (투표 1회 작성 후 수정 불가)
    match /mvp_votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Match Reminders Collection
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn();
    }

    // Workspace Integrations
    match /workspace/{workspaceId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
