rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection (Student ID based registration & profile sync)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Notices Collection (Public festival announcements)
    match /notices/{noticeId} {
      allow read, write: if true;
    }

    // Matches Collection (Competition schedules, live scores and timers)
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Lineups Collection (Class competition lineups)
    match /lineups/{lineupId} {
      allow read, write: if true;
    }

    // Messages (쪽지) Collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Direct Messages Collection
    match /direct_messages/{messageId} {
      allow read, write: if true;
    }

    // Cheers (실시간 응원 카운터) Collection
    match /cheers/{cheerId} {
      allow read, write: if true;
    }

    // Cheer messages feed
    match /cheer_messages/{cheerId} {
      allow read, write: if true;
    }

    // Live Reactions (이모지 실시간 인터랙션)
    match /live_reactions/{reactionId} {
      allow read, write: if true;
    }

    // Injury Encyclopedia (부상 지식백과) Collection
    match /injuries/{injuryId} {
      allow read, write: if true;
    }

    // Suggestions (실명 건의함) Collection
    match /suggestions/{suggestionId} {
      allow read, write: if true;
    }

    // Audit Logs (스코어 수정 감사 로그 - 절대 불변/삭제 불가)
    match /audit_logs/{logId} {
      allow read, create: if true;
      // Enforce strict immutability: no updates or deletes permitted
      allow update, delete: if false;
    }

    // System & Festival Config Collection
    match /system/{docId} {
      allow read, write: if true;
    }

    // MVP Votes Collection (경기 종료 후 MVP 투표 - document ID: matchId_voterStudentId)
    match /mvp_votes/{voteId} {
      allow read: if true;
      allow create, update: if request.resource.data.voterStudentId != null
        && request.resource.data.matchId != null
        && voteId == request.resource.data.matchId + '_' + request.resource.data.voterStudentId
        && request.resource.data.candidateName is string
        && request.resource.data.candidateName.size() > 0;
    }

    // Match Reminders Collection
    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    // Score Approvals Collection
    match /score_approvals/{approvalId} {
      allow read, write: if true;
    }

    // Login Inquiries Collection (로그인 문제 접수)
    match /login_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // App Documents (체육대회 규정집, 스마트랩 소개, 개인정보처리방침 등)
    match /app_documents/{docId} {
      allow read, write: if true;
    }
  }
}
